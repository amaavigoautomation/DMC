APP_ORIGIN=https://dmc24.in
HOST=127.0.0.1
PORT=3000
TRUST_LOCAL_PROXY=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dmc24
DB_USER=dmc24_app
DB_PASSWORD=
DB_POOL_SIZE=10
# For remote MySQL, use the provider CA to verify TLS.
DB_SSL_CA=
# Output of admin:credential, JSON in single quotes. Never use a shared default password.
ADMIN_CREDENTIAL=
# 64 lowercase hex characters; retain the OLD key to decrypt migrated email secrets.
EMAIL_ENCRYPTION_KEY=
UPLOAD_DIR=/var/lib/dmc24/uploads
# Enable only during a controlled import to an empty target, then remove it.
CONFIRM_EMPTY_IMPORT=no
