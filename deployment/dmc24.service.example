[Unit]
Description=DMC24 website
After=network.target
[Service]
User=dmc24
Group=dmc24
WorkingDirectory=/opt/dmc24
ExecStart=/usr/bin/node --env-file=/etc/dmc24/production.env /opt/dmc24/runtime/server.mjs
Restart=on-failure
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dmc24
[Install]
WantedBy=multi-user.target
