# Install certificates separately. Node must listen on loopback; do not expose :3000.
server {
 listen 80;
 server_name dmc24.in www.dmc24.in;
 return 301 https://dmc24.in$request_uri;
}
server {
 listen 443 ssl;
 server_name www.dmc24.in;
 ssl_certificate /etc/letsencrypt/live/dmc24.in/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/dmc24.in/privkey.pem;
 return 301 https://dmc24.in$request_uri;
}
server {
 listen 443 ssl;
 server_name dmc24.in;
 ssl_certificate /etc/letsencrypt/live/dmc24.in/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/dmc24.in/privkey.pem;
 client_max_body_size 3m;
 gzip on;
 gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
 # No static HTML alias or try_files: that would bypass visibility and admin protection.
 location / {
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  # Leave empty unless generated by a verified GeoIP integration on this proxy.
  proxy_set_header X-Verified-Country "";
  proxy_read_timeout 60s;
 }
}
